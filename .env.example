# Create .env yourself in the project root. Never commit real credentials.
PORT=8080
NODE_ENV=development

# PostgreSQL: existing separate fields are supported directly.
PGHOST=localhost
PGPORT=5432
PGDATABASE=badminton_db
PGUSER=postgres
PGPASSWORD=
# Optional alternative: DATABASE_URL takes precedence over all PG* fields.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# Two different random secrets, each at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI in your Google OAuth Web application client.
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8080

# Optional access policies (defaults shown).
ALLOWED_EMAIL_DOMAIN=nitw.ac.in
ADMIN_EMAILS=
TRUST_PROXY_HOPS=0

# Mail is opt-in. Start the separate mail worker after applying migrations.
MAIL_MODE=disabled
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Courtly <your_email@gmail.com>"
# MAIL_MODE=smtp enables delivery. Port 465 uses TLS; other ports require STARTTLS.
# APP_ORIGIN above is the email link destination. APP_SIGNING_SECRET is not needed:
# recipients sign in and respond through the existing authorized booking endpoints.
